<Window x:Class="WebsiteBlocker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Website Blocker"
        Width="900"
        Height="600"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="Website Blocker"
                       FontSize="32"
                       FontWeight="Bold"/>

            <TextBlock Text="Manage the websites you want to block."
                       FontSize="15"
                       Opacity="0.7"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <!-- Add Website -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="WebsiteTextBox"
                     Grid.Column="0"
                     Height="40"
                     FontSize="16"
                     Padding="10"
                     VerticalContentAlignment="Center"
                     ToolTip="Example: youtube.com"/>

            <Button Grid.Column="1"
                    Content="Add"
                    Height="40"
                    Margin="10,0,0,0"
                    Click="AddWebsite_Click"/>

        </Grid>

        <!-- Website List -->
        <Border Grid.Row="4"
                BorderThickness="1"
                BorderBrush="Gray"
                CornerRadius="8"
                Padding="10">

            <ListBox x:Name="WebsiteListBox"
                     BorderThickness="0">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <Grid Margin="5">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding}"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Content="Remove"
                                    Click="RemoveWebsite_Click"/>

                        </Grid>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

        </Border>

        <!-- Bottom controls -->
        <Grid Grid.Row="6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">

                <Ellipse x:Name="StatusIndicator"
                         Width="14"
                         Height="14"
                         Fill="Gray"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"/>

                <TextBlock x:Name="StatusText"
                           Text="Blocker OFF"
                           FontSize="16"
                           VerticalAlignment="Center"/>

            </StackPanel>

            <Button Grid.Column="1"
                    x:Name="ToggleButton"
                    Content="Enable Blocker"
                    Width="150"
                    Height="40"
                    Click="ToggleBlocker_Click"/>

        </Grid>

    </Grid>

</Window>